# Copy to .env (gitignored). api reads ../.env and api/.env; docker compose reads ./.env.

# --- api (docs/API.md §1.2) ---
AUTH_MODE=dev                 # dev = X-Demo-User header | tide = verify JWT via JWKS
GOVERNANCE_MODE=mock          # mock | real (TideCloak change requests, TODO #15)
AGENT_MODE=scripted           # scripted | llm (llm needs ANTHROPIC_API_KEY)
SCAN_MODE=heuristic           # heuristic | model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_STEP_DELAY_S=1.2       # pause between scripted steps (demo pacing)
AGENT_TOOL_TIMEOUT_S=30      # wait for the Agent Console tab to answer decrypt_records
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=cosign
JWKS_URL=                     # default ${TIDECLOAK_URL}/realms/${TIDECLOAK_REALM}/protocol/openid-connect/certs
DB_PATH=./cosign.db
# MOCKS_DIR=../docs/mocks     # default: <repo>/docs/mocks

# --- web (baked at build time) ---
NEXT_PUBLIC_API_MODE=mock     # mock = read web/public/mocks | live = call api
NEXT_PUBLIC_TIDE_MODE=mock    # mock = fake doEncrypt/doDecrypt | live = TideCloakProvider + IAMService
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- tidecloak (docker compose) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=password
